# Installed as /etc/used/used.env (root-owned, mode 0600).
# Use simple unquoted values; generate passwords as hex to avoid parser differences.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=used
DB_USER=used
DB_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME
INTERNAL_API_TOKEN=REPLACE_ME
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=used
RABBITMQ_PASSWORD=REPLACE_ME
KAFKA_CLUSTER_ID=REPLACE_ME
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
PAYMENT_KAFKA_CONCURRENCY=3
ACCOUNTS_BASE_URL=http://127.0.0.1:8081
MARKETPLACE_BASE_URL=http://127.0.0.1:8083
NOTIFICATION_BASE_URL=http://127.0.0.1:8085
AUDIT_BASE_URL=http://127.0.0.1:8087
MEDIA_BASE_URL=http://127.0.0.1:8088
MEDIA_PUBLIC_BASE_URL=
SERVER_ADDRESS=127.0.0.1
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# Temporary HTTP demonstration only; use true once HTTPS is configured.
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://REPLACE_PUBLIC_IP
SPRING_MAIL_HOST=REPLACE_SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=REPLACE_SMTP_USERNAME
SPRING_MAIL_PASSWORD=REPLACE_SMTP_PASSWORD
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_CONNECTIONTIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_PROPERTIES_MAIL_SMTP_WRITETIMEOUT=5000
