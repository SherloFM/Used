IMAGE_TAG=local

# Stable KRaft cluster ID, generated once with kafka-storage.sh random-uuid.
KAFKA_CLUSTER_ID=
PAYMENT_KAFKA_CONCURRENCY=3

POSTGRES_DB=used
POSTGRES_USER=used
POSTGRES_PASSWORD=

# Base64 encoding of at least 32 random bytes.
JWT_SECRET=
# At least 32 characters.
INTERNAL_API_TOKEN=

RABBITMQ_USERNAME=used
RABBITMQ_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# Leave empty: Media then stores relative /api/media/{id} paths, which the
# gateway resolves against the origin the browser already loaded.
MEDIA_PUBLIC_BASE_URL=

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050
